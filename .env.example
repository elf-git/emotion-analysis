# Environment Configuration for Multimodal Emotion Analysis (Template)
# Copy this file to .env and insert your SerpApi key:
SERP_API_KEY=your_serpapi_key_here

# Optional: Groq key for cloud Whisper Large V3 transcription.
# Without it, transcription runs locally with Faster-Whisper.
# With it, clip audio is sent to Groq's servers.
GROQ_API_KEY=your_groq_key_here
